{
  "name": "creator-deal-agent",
  "version": "0.1.0",
  "description": "A creator inbox that only accepts collab offers from human-backed brand agents (Self Agent ID) who pay a small x402 fee in stablecoins on Celo.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "register:8004": "tsx scripts/register-8004.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@selfxyz/agent-sdk": "^0.3.1",
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/express": "^2.32.0",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.1"
  }
}
