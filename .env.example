# Copy to .env and fill in. NEVER commit .env or any private key.

# Network: "mainnet" (Celo, chain 42220) or "testnet" (Celo Sepolia, chain 11142220)
CELO_NETWORK=mainnet
PORT=3000
# Public URL of this service (used in the ERC-8004 registration file)
PUBLIC_URL=http://localhost:3000

# Creator inbox token (GET/PATCH /offers, GET /activity). Any long random string.
CREATOR_TOKEN=

# --- x402 (seller side) ---
# Wallet that receives the offer fee. Use a fresh wallet, not your main one.
PAY_TO_ADDRESS=0xYourCreatorPayoutAddress
# Offer fee in atomic units of a 6-decimal stablecoin (10000 = 0.01 USDT)
OFFER_FEE_ATOMIC=10000
# Celo facilitator API key from https://x402.celo.org (dashboard)
X402_API_KEY=

# --- Self Agent ID (verifier side) ---
# Max agents per human the inbox accepts (0 = no cap, SDK default is 1)
SELF_SYBIL_LIMIT=0
SELF_RATE_LIMIT_PER_MINUTE=10

# --- Attribution (ERC-8021) ---
# Comma-separated codes. First: Loops House builder tag (required for scoring).
# Second: codeFromRepo("neqro/creator-deal-agent") = celo_4a75b42fc868.
ATTRIBUTION_CODES=celo_28a711ea2d86,celo_4a75b42fc868

# --- Only for scripts that send transactions (ERC-8004 register, demo agents) ---
# Leave empty for the server. Fill locally only, never commit.
OPERATOR_PRIVATE_KEY=
BRAND_AGENT_PRIVATE_KEY=
# Optional: persist inbox across restarts
DATA_FILE=./data/inbox.json
